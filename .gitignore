# Environment / caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Backups created by the server (slot folders since v1.6; the *.bak-* pattern
# stays for straggler files from the pre-v1.6 scheme)
.ks4w-backups/
*.bak-*.docx

# Local test corpus (generated by tests/make_corpus.py, or drop your own
# .docx files here).
tests/corpus/*.docx

# Build artifacts
dist/
build/

# packed bundles ship as release assets, not commits
bundle/*.mcpb
